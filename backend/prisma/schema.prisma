// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// PARTNERS & USERS
// ─────────────────────────────────────────────

model Partner {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users          User[]
  tags           PartnerTag[]
  sources        PartnerSource[]
  leadSnapshots  LeadSnapshot[]
  statusHistory  LeadStatusHistory[]

  @@map("partners")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  partnerId    String?  @map("partner_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  partner           Partner?          @relation(fields: [partnerId], references: [id])
  refreshSessions   RefreshSession[]
  notificationPrefs NotificationPref?
  auditLogs         AuditLog[]

  @@index([partnerId])
  @@map("users")
}

enum UserRole {
  partner_user
  admin
}

// ─────────────────────────────────────────────
// PARTNER TAG & SOURCE BINDINGS
// ─────────────────────────────────────────────

model PartnerTag {
  id           BigInt   @id @default(autoincrement())
  partnerId    String   @map("partner_id")
  amocrmTagId  BigInt   @map("amocrm_tag_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, amocrmTagId])
  @@index([partnerId])
  @@map("partner_tags")
}

// Поле "Источник" в amoCRM → дозволені джерела для партнера
model PartnerSource {
  id            BigInt   @id @default(autoincrement())
  partnerId     String   @map("partner_id")
  amocrmSource  String   @map("amocrm_source")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, amocrmSource])
  @@index([partnerId])
  @@map("partner_sources")
}

// ─────────────────────────────────────────────
// AUTH SESSIONS
// ─────────────────────────────────────────────

model RefreshSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_sessions")
}

// ─────────────────────────────────────────────
// LEADS (local projection, synced from amoCRM)
// ─────────────────────────────────────────────

model LeadSnapshot {
  id               BigInt   @id @default(autoincrement())
  externalLeadId   BigInt   @map("external_lead_id")
  partnerId        String   @map("partner_id")
  title            String
  status           String
  budget           Decimal? @db.Decimal(18, 2)
  city             String?
  comment          String?
  contactName      String?  @map("contact_name")
  contactPhone     String?  @map("contact_phone")
  contactEmail     String?  @map("contact_email")
  brokerName       String?  @map("broker_name")
  brokerPhone      String?  @map("broker_phone")
  brokerEmail      String?  @map("broker_email")
  amocrmSource     String?  @map("amocrm_source")
  tagIds           BigInt[] @map("tag_ids")
  updatedAtSource  DateTime @map("updated_at_source") @db.Timestamptz
  syncedAt         DateTime @map("synced_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id])

  @@unique([externalLeadId, partnerId])
  @@index([partnerId, updatedAtSource(sort: Desc)])
  @@index([externalLeadId])
  @@map("lead_snapshots")
}

model LeadStatusHistory {
  id             BigInt   @id @default(autoincrement())
  externalLeadId BigInt   @map("external_lead_id")
  partnerId      String   @map("partner_id")
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  changedAt      DateTime @map("changed_at") @db.Timestamptz
  changedBy      String?  @map("changed_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, changedAt(sort: Desc)])
  @@map("lead_status_history")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model NotificationPref {
  userId          String   @id @map("user_id")
  onStatusChange  Boolean  @default(true) @map("on_status_change")
  onBrokerChange  Boolean  @default(true) @map("on_broker_change")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("notification_prefs")
}

// ─────────────────────────────────────────────
// WEBHOOKS
// ─────────────────────────────────────────────

model WebhookEvent {
  id           BigInt           @id @default(autoincrement())
  eventId      String           @unique @map("event_id")
  source       String
  payload      Json
  receivedAt   DateTime         @map("received_at") @db.Timestamptz
  processedAt  DateTime?        @map("processed_at") @db.Timestamptz
  status       WebhookStatus    @default(received)
  errorMessage String?          @map("error_message")

  @@index([status, receivedAt])
  @@map("webhook_events")
}

enum WebhookStatus {
  received
  processed
  failed
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  requestId   String   @map("request_id")
  actorUserId String?  @map("actor_user_id")
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
